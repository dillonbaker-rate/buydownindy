# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to store lender leads and by the weekly rate job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Emails allowed to enter daily rates at /agent/rates (comma-separated).
ADMIN_EMAILS=

# ── Weekly Freddie Mac PMMS job (Vercel Cron sends this as a Bearer token) ──
CRON_SECRET=

# ── Map tiles (production needs one of these; OSM public tiles are dev-only) ──
NEXT_PUBLIC_MAPTILER_KEY=
# or any XYZ provider:
# NEXT_PUBLIC_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; Stadia Maps &copy; OpenStreetMap contributors

# ── Address typeahead (optional; falls back to Photon/OSM) ──
MAPBOX_TOKEN=

# ── New-lead email notifications (resend.com) ──
RESEND_API_KEY=
# Where lead emails go (comma-separated)
LEAD_NOTIFY_TO=
# Verified sender. Until a domain is verified in Resend, leave blank: it sends from
# onboarding@resend.dev, which only delivers to your own Resend account email.
LEAD_NOTIFY_FROM=

# Show the design's 12 "Sample" listings when Supabase isn't connected (off by default).
# SHOW_SAMPLE_LISTINGS=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000
